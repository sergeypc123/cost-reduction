<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Defs_Onboarding" targetNamespace="http://vitastore.example/bpmn">

  <bpmn:collaboration id="Collab_1">
    <bpmn:participant id="P_AI" name="ИИ-сервис маппинга (облако)" />
    <bpmn:participant id="P_Main" name="VitaStore: онбординг купленного магазина" processRef="Process_Onboarding" />
    <bpmn:participant id="P_SAP" name="SAP ERP (эталонная номенклатура)" />
    <bpmn:participant id="P_POS" name="Cloud POS" />
    <bpmn:messageFlow id="MF_SAPRef" name="Эталонный справочник SKU" sourceRef="P_SAP" targetRef="Task_Barcode" />
    <bpmn:messageFlow id="MF_AIReq" name="Несопоставленные позиции" sourceRef="Task_AI" targetRef="P_AI" />
    <bpmn:messageFlow id="MF_AIResp" name="Кандидаты + уверенность" sourceRef="P_AI" targetRef="Task_AI" />
    <bpmn:messageFlow id="MF_Feedback" name="Подтверждённые пары (дообучение)" sourceRef="Task_Manual" targetRef="P_AI" />
    <bpmn:messageFlow id="MF_SAPLoad" name="Сопоставления и новые SKU" sourceRef="Task_SAP" targetRef="P_SAP" />
    <bpmn:messageFlow id="MF_POS" name="Номенклатура и прайс магазина" sourceRef="Task_Publish" targetRef="P_POS" />
  </bpmn:collaboration>

  <bpmn:process id="Process_Onboarding" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_MA" name="Менеджер M&amp;A / ИТ (удалённо)">
        <bpmn:flowNodeRef>Start_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Export</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Test</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_DIP" name="Платформа интеграции данных">
        <bpmn:flowNodeRef>Task_Normalize</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Barcode</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AI</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Conf</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Auto</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Issues</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SAP</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Publish</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Merch" name="Товаровед HQ">
        <bpmn:flowNodeRef>Task_Manual</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:dataObject id="DO_Export" />
    <bpmn:dataObject id="DO_Norm" />
    <bpmn:dataObject id="DO_Map" />
    <bpmn:dataObjectReference id="DOR_Export" name="Выгрузка номенклатуры (CSV/XLS)" dataObjectRef="DO_Export" />
    <bpmn:dataObjectReference id="DOR_Norm" name="Нормализованная номенклатура" dataObjectRef="DO_Norm" />
    <bpmn:dataObjectReference id="DOR_Map" name="Таблица сопоставлений (SKU, уверенность)" dataObjectRef="DO_Map" />

    <bpmn:startEvent id="Start_1" name="Сделка закрыта, магазин передан">
      <bpmn:outgoing>F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_Export" name="Запустить удалённую выгрузку номенклатуры">
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DOA_Export"><bpmn:targetRef>DOR_Export</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_Normalize" name="Принять и нормализовать выгрузку">
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:outgoing>F3</bpmn:outgoing>
      <bpmn:property id="Prop_Normalize" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DIA_Normalize"><bpmn:sourceRef>DOR_Export</bpmn:sourceRef><bpmn:targetRef>Prop_Normalize</bpmn:targetRef></bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="DOA_Normalize"><bpmn:targetRef>DOR_Norm</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_Barcode" name="Сопоставить по штрихкоду с эталоном">
      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:outgoing>F4</bpmn:outgoing>
      <bpmn:property id="Prop_Barcode" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DIA_Barcode"><bpmn:sourceRef>DOR_Norm</bpmn:sourceRef><bpmn:targetRef>Prop_Barcode</bpmn:targetRef></bpmn:dataInputAssociation>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_AI" name="Получить ИИ-сопоставление и оценку уверенности">
      <bpmn:incoming>F4</bpmn:incoming>
      <bpmn:outgoing>F5</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DOA_AI"><bpmn:targetRef>DOR_Map</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="GW_Conf" name="Уверенность ≥ 95% и правила пройдены?">
      <bpmn:incoming>F5</bpmn:incoming>
      <bpmn:outgoing>F6</bpmn:outgoing>
      <bpmn:outgoing>F7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_Auto" name="Принять сопоставление автоматически">
      <bpmn:incoming>F6</bpmn:incoming>
      <bpmn:outgoing>F8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Task_Manual" name="Проверить и сопоставить вручную">
      <bpmn:incoming>F7</bpmn:incoming>
      <bpmn:incoming>F13</bpmn:incoming>
      <bpmn:outgoing>F9</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_Merge">
      <bpmn:incoming>F8</bpmn:incoming>
      <bpmn:incoming>F9</bpmn:incoming>
      <bpmn:outgoing>F10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_Check" name="Автопроверки: цена, дубли, контрольная выборка">
      <bpmn:incoming>F10</bpmn:incoming>
      <bpmn:outgoing>F11</bpmn:outgoing>
      <bpmn:property id="Prop_Check" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DIA_Check"><bpmn:sourceRef>DOR_Map</bpmn:sourceRef><bpmn:targetRef>Prop_Check</bpmn:targetRef></bpmn:dataInputAssociation>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="GW_Issues" name="Есть расхождения?">
      <bpmn:incoming>F11</bpmn:incoming>
      <bpmn:outgoing>F12</bpmn:outgoing>
      <bpmn:outgoing>F13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_SAP" name="Загрузить сопоставления в SAP ERP">
      <bpmn:incoming>F12</bpmn:incoming>
      <bpmn:outgoing>F14</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_Publish" name="Опубликовать номенклатуру и цены в Cloud POS">
      <bpmn:incoming>F14</bpmn:incoming>
      <bpmn:outgoing>F15</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Task_Test" name="Провести пробную продажу">
      <bpmn:incoming>F15</bpmn:incoming>
      <bpmn:outgoing>F16</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_1" name="Магазин готов к открытию">
      <bpmn:incoming>F16</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="F1" sourceRef="Start_1" targetRef="Task_Export" />
    <bpmn:sequenceFlow id="F2" sourceRef="Task_Export" targetRef="Task_Normalize" />
    <bpmn:sequenceFlow id="F3" sourceRef="Task_Normalize" targetRef="Task_Barcode" />
    <bpmn:sequenceFlow id="F4" sourceRef="Task_Barcode" targetRef="Task_AI" />
    <bpmn:sequenceFlow id="F5" sourceRef="Task_AI" targetRef="GW_Conf" />
    <bpmn:sequenceFlow id="F6" name="да" sourceRef="GW_Conf" targetRef="Task_Auto" />
    <bpmn:sequenceFlow id="F7" name="нет" sourceRef="GW_Conf" targetRef="Task_Manual" />
    <bpmn:sequenceFlow id="F8" sourceRef="Task_Auto" targetRef="GW_Merge" />
    <bpmn:sequenceFlow id="F9" sourceRef="Task_Manual" targetRef="GW_Merge" />
    <bpmn:sequenceFlow id="F10" sourceRef="GW_Merge" targetRef="Task_Check" />
    <bpmn:sequenceFlow id="F11" sourceRef="Task_Check" targetRef="GW_Issues" />
    <bpmn:sequenceFlow id="F12" name="нет" sourceRef="GW_Issues" targetRef="Task_SAP" />
    <bpmn:sequenceFlow id="F13" name="да" sourceRef="GW_Issues" targetRef="Task_Manual" />
    <bpmn:sequenceFlow id="F14" sourceRef="Task_SAP" targetRef="Task_Publish" />
    <bpmn:sequenceFlow id="F15" sourceRef="Task_Publish" targetRef="Task_Test" />
    <bpmn:sequenceFlow id="F16" sourceRef="Task_Test" targetRef="End_1" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="Diagram_1">
    <bpmndi:BPMNPlane id="Plane_1" bpmnElement="Collab_1">
      <bpmndi:BPMNShape id="P_AI_di" bpmnElement="P_AI" isHorizontal="true"><dc:Bounds x="600" y="40" width="420" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P_Main_di" bpmnElement="P_Main" isHorizontal="true"><dc:Bounds x="160" y="160" width="1700" height="540" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_MA_di" bpmnElement="Lane_MA" isHorizontal="true"><dc:Bounds x="190" y="160" width="1670" height="180" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_DIP_di" bpmnElement="Lane_DIP" isHorizontal="true"><dc:Bounds x="190" y="340" width="1670" height="180" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Merch_di" bpmnElement="Lane_Merch" isHorizontal="true"><dc:Bounds x="190" y="520" width="1670" height="180" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P_SAP_di" bpmnElement="P_SAP" isHorizontal="true"><dc:Bounds x="500" y="760" width="1100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P_POS_di" bpmnElement="P_POS" isHorizontal="true"><dc:Bounds x="1620" y="760" width="240" height="80" /></bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Start_1_di" bpmnElement="Start_1"><dc:Bounds x="232" y="232" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Export_di" bpmnElement="Task_Export"><dc:Bounds x="300" y="210" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Normalize_di" bpmnElement="Task_Normalize"><dc:Bounds x="450" y="390" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Barcode_di" bpmnElement="Task_Barcode"><dc:Bounds x="600" y="390" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_AI_di" bpmnElement="Task_AI"><dc:Bounds x="750" y="390" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW_Conf_di" bpmnElement="GW_Conf" isMarkerVisible="true"><dc:Bounds x="900" y="405" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Auto_di" bpmnElement="Task_Auto"><dc:Bounds x="1000" y="390" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Manual_di" bpmnElement="Task_Manual"><dc:Bounds x="1000" y="570" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW_Merge_di" bpmnElement="GW_Merge" isMarkerVisible="true"><dc:Bounds x="1150" y="405" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Check_di" bpmnElement="Task_Check"><dc:Bounds x="1240" y="390" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW_Issues_di" bpmnElement="GW_Issues" isMarkerVisible="true"><dc:Bounds x="1390" y="405" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_SAP_di" bpmnElement="Task_SAP"><dc:Bounds x="1480" y="390" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Publish_di" bpmnElement="Task_Publish"><dc:Bounds x="1630" y="390" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Test_di" bpmnElement="Task_Test"><dc:Bounds x="1630" y="210" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_1_di" bpmnElement="End_1"><dc:Bounds x="1782" y="232" width="36" height="36" /></bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="DOR_Export_di" bpmnElement="DOR_Export"><dc:Bounds x="420" y="170" width="36" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DOR_Norm_di" bpmnElement="DOR_Norm"><dc:Bounds x="557" y="345" width="36" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DOR_Map_di" bpmnElement="DOR_Map"><dc:Bounds x="1195" y="345" width="36" height="50" /></bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="F1_di" bpmnElement="F1"><di:waypoint x="268" y="250" /><di:waypoint x="300" y="250" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F2_di" bpmnElement="F2"><di:waypoint x="400" y="250" /><di:waypoint x="500" y="250" /><di:waypoint x="500" y="390" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F3_di" bpmnElement="F3"><di:waypoint x="550" y="430" /><di:waypoint x="600" y="430" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F4_di" bpmnElement="F4"><di:waypoint x="700" y="430" /><di:waypoint x="750" y="430" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F5_di" bpmnElement="F5"><di:waypoint x="850" y="430" /><di:waypoint x="900" y="430" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F6_di" bpmnElement="F6"><di:waypoint x="950" y="430" /><di:waypoint x="1000" y="430" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F7_di" bpmnElement="F7"><di:waypoint x="925" y="455" /><di:waypoint x="925" y="610" /><di:waypoint x="1000" y="610" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F8_di" bpmnElement="F8"><di:waypoint x="1100" y="430" /><di:waypoint x="1150" y="430" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F9_di" bpmnElement="F9"><di:waypoint x="1100" y="610" /><di:waypoint x="1175" y="610" /><di:waypoint x="1175" y="455" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F10_di" bpmnElement="F10"><di:waypoint x="1200" y="430" /><di:waypoint x="1240" y="430" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F11_di" bpmnElement="F11"><di:waypoint x="1340" y="430" /><di:waypoint x="1390" y="430" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F12_di" bpmnElement="F12"><di:waypoint x="1440" y="430" /><di:waypoint x="1480" y="430" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F13_di" bpmnElement="F13"><di:waypoint x="1415" y="455" /><di:waypoint x="1415" y="635" /><di:waypoint x="1100" y="635" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F14_di" bpmnElement="F14"><di:waypoint x="1580" y="430" /><di:waypoint x="1630" y="430" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F15_di" bpmnElement="F15"><di:waypoint x="1680" y="390" /><di:waypoint x="1680" y="290" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F16_di" bpmnElement="F16"><di:waypoint x="1730" y="250" /><di:waypoint x="1782" y="250" /></bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="DOA_Export_di" bpmnElement="DOA_Export"><di:waypoint x="390" y="210" /><di:waypoint x="420" y="200" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DIA_Normalize_di" bpmnElement="DIA_Normalize"><di:waypoint x="450" y="220" /><di:waypoint x="470" y="390" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DOA_Normalize_di" bpmnElement="DOA_Normalize"><di:waypoint x="550" y="400" /><di:waypoint x="557" y="380" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DIA_Barcode_di" bpmnElement="DIA_Barcode"><di:waypoint x="593" y="380" /><di:waypoint x="610" y="390" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DOA_AI_di" bpmnElement="DOA_AI"><di:waypoint x="850" y="395" /><di:waypoint x="1195" y="365" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DIA_Check_di" bpmnElement="DIA_Check"><di:waypoint x="1231" y="380" /><di:waypoint x="1250" y="390" /></bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="MF_SAPRef_di" bpmnElement="MF_SAPRef"><di:waypoint x="650" y="760" /><di:waypoint x="650" y="470" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="MF_AIReq_di" bpmnElement="MF_AIReq"><di:waypoint x="780" y="390" /><di:waypoint x="780" y="120" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="MF_AIResp_di" bpmnElement="MF_AIResp"><di:waypoint x="820" y="120" /><di:waypoint x="820" y="390" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="MF_Feedback_di" bpmnElement="MF_Feedback"><di:waypoint x="1000" y="630" /><di:waypoint x="970" y="630" /><di:waypoint x="970" y="120" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="MF_SAPLoad_di" bpmnElement="MF_SAPLoad"><di:waypoint x="1530" y="470" /><di:waypoint x="1530" y="760" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="MF_POS_di" bpmnElement="MF_POS"><di:waypoint x="1680" y="470" /><di:waypoint x="1680" y="760" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>